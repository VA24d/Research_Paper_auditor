# Settings of the P4.6 set C experiments (docs/p4-results.md). Load before `auditor batch`:
#   set -a; source configs/experiments/set_c.env; set +a
# They repeat the earlier RQ1 runs (rq1-c5, results/README.md): Gemini 3.8 Flash on the
# team's Vertex project, method check in "rag" mode with nomic embeddings, the citation
# agent left out (set C labels no citation classes). Its planner pass over citation
# candidates is off too: with the agent left out it only cost money.
AUDITOR_LLM_PROVIDER=google_genai
AUDITOR_LLM_MODEL=gemini-3.8-flash
AUDITOR_LLM_OPTIONS='{"vertexai": true, "project": "lmaproject6767", "location": "global", "max_output_tokens": 32768}'
AUDITOR_LLM_REVIEW_MODEL=gemini-3.8-flash
AUDITOR_LLM_MAX_CONCURRENCY=4
# Vertex answers 429 when the shared quota is busy; retry with backoff (team limit: 5).
AUDITOR_LLM_MAX_RETRIES=5
AUDITOR_SKIP_PARTS='["citation"]'
AUDITOR_CITATION_LLM_ENABLED=false
# An OpenAI-compatible embeddings endpoint serving nomic-embed-text-v1.5 (LM Studio, or
# any server for that model). Embeddings are cached under data/cache/embeddings.
AUDITOR_EMBED_URL=http://localhost:1234
# Spend limits: per run (one system, one repetition), and for all runs together through
# a shared ledger, which stops every run once the total is reached.
AUDITOR_LLM_MAX_CALLS=3000
AUDITOR_LLM_MAX_COST_USD=40
AUDITOR_LLM_LEDGER=data/p4/ledger.jsonl
AUDITOR_LLM_LEDGER_LIMIT_USD=125
