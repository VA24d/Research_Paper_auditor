{"schema_version":1,"task_id":"code-63ecb994f99e732b","paper_id":"2208.04654v1","variant":"original","kind":"code","outcome":"checked","reason":null,"error":null,"findings":[{"finding_id":"code-63ecb994f99e732b-f0","task_id":"code-63ecb994f99e732b","paper_id":"2208.04654v1","variant":"original","error_class":"setting_mismatch","anchor":{"kind":"sentence","sentence_id":"s94","start":11,"end":15},"target":{"kind":"setting","key":"optimizer"},"summary":"The paper states optimizer Adam; the repository has adamw (main.py:164)","explanation":"Static scan of https://github.com/axeber01/ngcc@2210bf55395669c1c39d49f65f286fc9a1523fc9; no value found for optimizer matches the paper.","evidence":[{"kind":"quote","source":{"kind":"submission","id":"2208.04654v1","title":null,"url":null},"text":"We use the Adam optimizer [23] with a batch size of 32, a learning rate of 0.001 with a cosine decay schedule and train the network for 30 epochs.","page":null,"char_start":null,"char_end":null,"path":null,"line_start":null,"line_end":null},{"kind":"code","source":{"kind":"repository","id":"https://github.com/axeber01/ngcc@2210bf55395669c1c39d49f65f286fc9a1523fc9","title":null,"url":"https://github.com/axeber01/ngcc"},"text":"optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=wd)","page":null,"char_start":null,"char_end":null,"path":"main.py","line_start":164,"line_end":null}],"uncertain":false}],"attempts":1}
