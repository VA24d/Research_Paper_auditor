{"schema_version":1,"run_id":"p4-setc-full-r1","system":"full","paper_id":"2002.02798v3","variant":"original","error_class":"setting_mismatch","anchor":{"kind":"sentence","sentence_id":"s171","start":183,"end":186},"target":{"kind":"setting","key":"batch_size"},"state":"verified_flag","summary":"The paper states batch_size 900; the repository has 200 (train.py:73)","evidence":[{"kind":"quote","source":{"kind":"submission","id":"2002.02798v3","title":null,"url":null},"text":"We suspect the discrepancy in performance and run times between our implementation of FFJORD and that of the original paper is due to batch size: Grathwohl et al. use a batch size of 900 and train on six GPUs, whereas on MNIST and CIFAR10 we use a batch size of 200 and train on a single GPU.","page":null,"char_start":null,"char_end":null,"path":null,"line_start":null,"line_end":null},{"kind":"code","source":{"kind":"repository","id":"https://github.com/cfinlay/ffjord-rnode@8302dfb806284f6c42da0687d6100f4bac45726f","title":null,"url":"https://github.com/cfinlay/ffjord-rnode"},"text":"    parser.add_argument(\"--batch_size\", type=int, default=200)","page":null,"char_start":null,"char_end":null,"path":"train.py","line_start":73,"line_end":null}],"finding_id":"code-044f248aa834c2d4-f0","severity":"medium","duplicate_of":null}
