{"schema_version":1,"task_id":"code-28072e0b6e9dfc17","paper_id":"2208.04654v1","variant":"injected","kind":"code","outcome":"checked","reason":null,"error":null,"findings":[{"finding_id":"code-28072e0b6e9dfc17-f0","task_id":"code-28072e0b6e9dfc17","paper_id":"2208.04654v1","variant":"injected","error_class":"method_mismatch","anchor":{"kind":"document"},"target":{"kind":"setting","key":"method"},"summary":"The paper specifies using GCC-PHAT for correlation of the filtered signals, but NGCCPHAT instantiates the correlation layer with filt='scot' (the SCOT filter) instead of PHAT.","explanation":"Model discrepancy, high confidence.","evidence":[{"kind":"quote","source":{"kind":"submission","id":"2208.04654v1","title":null,"url":null},"text":"For each of the L signal components, we then apply the GCC-PHAT individually as","page":null,"char_start":null,"char_end":null,"path":null,"line_start":null,"line_end":null},{"kind":"code","source":{"kind":"repository","id":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1@content-8f92090974c70cb2","title":null,"url":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1"},"text":"        self.gcc = GCC(max_tau=self.max_tau, dim=3, filt='scot')","page":null,"char_start":null,"char_end":null,"path":"model.py","line_start":119,"line_end":119}],"uncertain":false},{"finding_id":"code-28072e0b6e9dfc17-f1","task_id":"code-28072e0b6e9dfc17","paper_id":"2208.04654v1","variant":"injected","error_class":"method_mismatch","anchor":{"kind":"document"},"target":{"kind":"setting","key":"method"},"summary":"The network applies constant (zero) padding (mode='constant') before each convolutional layer instead of circular padding.","explanation":"Model discrepancy, high confidence.","evidence":[{"kind":"quote","source":{"kind":"submission","id":"2208.04654v1","title":null,"url":null},"text":"We therefore employ circular padding of the signals before each convolutional layer in the network in order to preserve the timing information completely.","page":null,"char_start":null,"char_end":null,"path":null,"line_start":null,"line_end":null},{"kind":"code","source":{"kind":"repository","id":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1@content-8f92090974c70cb2","title":null,"url":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1"},"text":"         padding = get_pad(\n             size=s, kernel_size=self.cnn_len_filt[i], stride=1, dilation=1)\n         x = F.pad(x, pad=padding, mode='constant')","page":null,"char_start":null,"char_end":null,"path":"dnn_models.py","line_start":452,"line_end":454}],"uncertain":false},{"finding_id":"code-28072e0b6e9dfc17-f2","task_id":"code-28072e0b6e9dfc17","paper_id":"2208.04654v1","variant":"injected","error_class":"method_mismatch","anchor":{"kind":"document"},"target":{"kind":"setting","key":"method"},"summary":"The paper specifies training the network using the Adam optimizer, but the code instantiates and uses SGD with momentum.","explanation":"Training discrepancy, high confidence.","evidence":[{"kind":"quote","source":{"kind":"submission","id":"2208.04654v1","title":null,"url":null},"text":"We use the Adam optimizer [23] with a batch size of 64, a learning rate of 0.001 with a cosine decay schedule and train the network for 60 epochs.","page":null,"char_start":null,"char_end":null,"path":null,"line_start":null,"line_end":null},{"kind":"code","source":{"kind":"repository","id":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1@content-8f92090974c70cb2","title":null,"url":"file:///home/dheeruys/Documents/Github/Research_Paper_auditor/data/set_c/patched/2208.04654v1"},"text":"optimizer = optim.SGD(model.parameters(), lr=lr, momentum=0.9, weight_decay=wd)","page":null,"char_start":null,"char_end":null,"path":"main.py","line_start":164,"line_end":164}],"uncertain":false}],"attempts":1}
