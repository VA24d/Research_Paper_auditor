# Copy to .env and adjust. .env is git-ignored; never commit real keys.

AUDITOR_DATA_DIR=data
AUDITOR_CACHE_DIR=data/cache
AUDITOR_RUNS_DIR=runs
AUDITOR_GROBID_URL=http://localhost:8070
AUDITOR_LOG_LEVEL=INFO

# Contact address sent to scholarly APIs (arXiv, Crossref) in the User-Agent header.
AUDITOR_CONTACT_EMAIL=

# LLM provider (decision D9 is still pending). Leave empty to run without an LLM.
# Gemini on Vertex AI (Google Cloud credits; log in once with
# `gcloud auth application-default login`):
#   AUDITOR_LLM_PROVIDER=google_genai
#   AUDITOR_LLM_MODEL=gemini-3.5-flash-lite
#   AUDITOR_LLM_OPTIONS={"vertexai": true, "project": "your-project-id", "location": "global"}
# Gemini with an AI Studio key:
#   AUDITOR_LLM_PROVIDER=google_genai
#   GOOGLE_API_KEY=...
# An OpenAI-compatible endpoint, such as Z.ai:
#   AUDITOR_LLM_PROVIDER=openai
#   AUDITOR_LLM_BASE_URL=https://api.z.ai/api/paas/v4/
#   AUDITOR_LLM_STRUCTURED_METHOD=json_mode
#   OPENAI_API_KEY=...
AUDITOR_LLM_PROVIDER=
AUDITOR_LLM_MODEL=
# Cache LLM answers on disk while developing; turn off for reported runs (decision D10).
AUDITOR_LLM_CACHE=true
