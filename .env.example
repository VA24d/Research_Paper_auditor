# Copy to .env and adjust. .env is git-ignored; never commit real keys.

AUDITOR_DATA_DIR=data
AUDITOR_CACHE_DIR=data/cache
AUDITOR_RUNS_DIR=runs
AUDITOR_GROBID_URL=http://localhost:8070
AUDITOR_LOG_LEVEL=INFO

# Contact address sent to scholarly APIs (arXiv, Crossref) in the User-Agent header.
AUDITOR_CONTACT_EMAIL=

# LLM provider (decision D9 is still pending; Gemini is the likely choice). Leave empty
# to run without an LLM. AUDITOR_LLM_OPTIONS is JSON passed to the chat model.
# Gemini on Vertex AI, which Google Cloud credits pay for (log in once with
# `gcloud auth application-default login`):
#   AUDITOR_LLM_PROVIDER=google_genai
#   AUDITOR_LLM_MODEL=gemini-3.5-flash-lite
#   AUDITOR_LLM_OPTIONS={"vertexai": true, "project": "your-project-id", "location": "global", "thinking_level": "low"}
# Gemini with an AI Studio key (cloud credits do not cover these keys):
#   AUDITOR_LLM_PROVIDER=google_genai
#   AUDITOR_LLM_MODEL=gemini-3.5-flash-lite
#   AUDITOR_LLM_OPTIONS={"thinking_level": "low"}
#   GOOGLE_API_KEY=...
# An OpenAI-compatible endpoint, such as Z.ai:
#   AUDITOR_LLM_PROVIDER=openai
#   AUDITOR_LLM_BASE_URL=https://api.z.ai/api/paas/v4/
#   AUDITOR_LLM_STRUCTURED_METHOD=json_mode
#   OPENAI_API_KEY=...
# A small local model through Ollama (OpenAI-compatible API). json_schema makes the server
# constrain the output to the schema, so small models do not produce unusable replies;
# num_ctx must cover the prompts, and AUDITOR_LLM_CONTEXT_TOKENS makes longer prompts fail
# loudly instead of being cut. Pair mode keeps each method-check prompt to one passage and
# one function.
#   AUDITOR_LLM_PROVIDER=openai
#   AUDITOR_LLM_BASE_URL=http://localhost:11434/v1
#   AUDITOR_LLM_MODEL=qwen3:8b
#   AUDITOR_LLM_STRUCTURED_METHOD=json_schema
#   AUDITOR_LLM_OPTIONS={"temperature": 0, "extra_body": {"options": {"num_ctx": 16384}}}
#   AUDITOR_LLM_CONTEXT_TOKENS=16384
#   AUDITOR_METHOD_CHECK_MODE=pairs
#   OPENAI_API_KEY=ollama
AUDITOR_LLM_PROVIDER=
AUDITOR_LLM_MODEL=
# Cache LLM answers on disk while developing. `auditor batch` ignores this and runs
# uncached unless given --llm-cache, so reported numbers come from fresh calls (D10).
AUDITOR_LLM_CACHE=true

# Repository and data snapshots (auditor.infra.snapshots). Only core files (code, configs,
# docs) are downloaded, into a scratch folder that is safe to delete. Defaults shown.
# AUDITOR_SCRATCH_DIR=        (default: <system temp>/auditor-scratch)
# AUDITOR_SNAPSHOT_MAX_FILE_BYTES=1000000
# AUDITOR_SNAPSHOT_MAX_TOTAL_BYTES=10000000
# AUDITOR_SNAPSHOT_MAX_FILES=500
# AUDITOR_SNAPSHOT_MAX_ARCHIVE_BYTES=50000000
# Data analysis mode (also: --analyse-data) downloads a dataset's CSV/TSV/JSONL/JSON/Parquet
# files to count rows, read labels and find test rows that also occur in training data.
# Parquet needs the optional extra: uv sync --extra data
# AUDITOR_DATA_ANALYSIS_ENABLED=false
# AUDITOR_DATA_ANALYSIS_MAX_FILE_BYTES=200000000
# AUDITOR_DATA_ANALYSIS_MAX_TOTAL_BYTES=1000000000
# AUDITOR_DATA_ANALYSIS_MAX_HASHED_ROWS=2000000
# Optional: GitHub allows 60 API requests an hour without a token; Hugging Face needs one
# for gated repositories.
AUDITOR_GITHUB_TOKEN=
AUDITOR_HF_TOKEN=
